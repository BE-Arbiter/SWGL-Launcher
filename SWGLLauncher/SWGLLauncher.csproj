<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Icone du jeu, reprise telle quelle de OpenJK-SWGL (code\win32\swgl-sp.ico) -->
    <ApplicationIcon>swgl-sp.ico</ApplicationIcon>

    <!-- Version du launcher, comparee au tag de la derniere release GitHub pour la mise
         a jour automatique. La GitHub Action la remplace par celle du tag publie. -->
    <Version>0.2.0-alpha</Version>

    <!-- Un seul exe a la publication : runtime, dependances et symboles inclus,
         bibliotheques natives comprises. Seul SWGL\launcher_music.mp3 reste a cote. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Evite les sous-dossiers de ressources localisees (cs\, de\, fr\...) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="FluentFTP" Version="55.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images embarquees dans l'executable. Un fichier pose a cote de l'exe au meme
         chemin reste prioritaire. launcher.properties n'est pas livre : les valeurs par
         defaut sont dans le code, le fichier ne sert qu'a les surcharger. -->
    <None Remove="SWGL\**\*" />
    <EmbeddedResource Include="SWGL\**\*" Exclude="SWGL\launcher_music.mp3" />

    <!-- La musique est livree a part, dans SWGL\ a cote de l'exe. ExcludeFromSingleFile
         est indispensable : sans lui le bundler l'avalerait dans l'executable. -->
    <None Include="SWGL\launcher_music.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
