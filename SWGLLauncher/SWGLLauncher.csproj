<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Icone du jeu, reprise telle quelle de OpenJK-SWGL (code\win32\swgl-sp.ico) -->
    <ApplicationIcon>swgl-sp.ico</ApplicationIcon>

    <!-- Un seul exe a la publication : runtime, dependances et symboles inclus,
         bibliotheques natives comprises. Seuls launcher.properties et le dossier
         SWGL restent a cote, puisqu'ils doivent rester modifiables. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Evite les sous-dossiers de ressources localisees (cs\, de\, fr\...) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="FluentFTP" Version="55.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fichiers de donnees : on ne les ecrase pas s'ils ont ete modifies a cote de l'exe.
         ExcludeFromSingleFile est indispensable : sans lui le bundler embarque ces fichiers
         dans l'exe et ils ne sont plus modifiables. -->
    <None Update="launcher.properties">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- Habillage embarque dans l'executable. Un fichier pose a cote de l'exe au chemin
         indique dans launcher.properties reste prioritaire. -->
    <None Remove="SWGL\**\*" />
    <EmbeddedResource Include="SWGL\**\*" />
  </ItemGroup>

</Project>
