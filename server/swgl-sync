#!/usr/bin/env bash
# ==============================================================================
# swgl-sync — manages the branches of the SWGL FTP repository: public and betas.
#
#   swgl-sync update [--branch <b>] [--label "<l>"] [--notify ["<message>"]] [--notify-ping <role>]
#   swgl-sync rename --branch <b> --label "<l>"
#   swgl-sync create --branch <code>
#   swgl-sync remove --branch <code>
#   swgl-sync exclude --branch <code> [path...]
#   swgl-sync restore --branch <code> <path...>
#   swgl-sync force-delete --branch <b> [path...]
#   swgl-sync cancel-delete --branch <b> <path...>
#
# A branch is "public" or a beta code. Beta <code> gets the account
# "swgl-<code>", password "<code>", which sees /base, /beta-<code>,
# /beta-<code>.diff and its own /manifest.json.
#
# Patch notes: patchnotes-public.md and patchnotes-<code>.md at the root of the
# repository, seen by each account as /patchnotes.md. Empty means no notes.
#
# --notify posts one Discord message for the manifests that changed, through the
# webhook set in /etc/swgl-sync.conf (root only):
#   webhook=https://discord.com/api/webhooks/...
#   role.Testers=123456789012345678       --notify-ping Testers pings this role
# ==============================================================================
set -euo pipefail

ROOT=/srv/swgl
JAILS=/srv/swgl-jails
GROUP=swgl
OWNER=swgl-dev
BETAS_CONF=/etc/proftpd/conf.d/swgl-betas.conf
CONFIG=/etc/swgl-sync.conf
MANIFEST_TOOL=${MANIFEST_TOOL:-SWGLManifest}

# Account prefix: must match the launcher's ftp.beta.user.prefix.
USER_PREFIX=swgl-
# Prefix of the beta folders and .diff files on disk.
DIR_PREFIX=beta-
PUBLIC=public

die() {
    echo "swgl-sync: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<EOF
usage:
  swgl-sync update [--branch <b>] [--label "<l>"] [--notify ["<message>"]] [--notify-ping <role>]
        regenerate one branch, or public then every beta without --branch;
        without --label the current label is kept; --notify posts one Discord
        message for the branches that changed, the message first if given;
        --notify-ping (repeatable) mentions a role declared in $CONFIG, or a
        role id; the message itself is never parsed for mentions
  swgl-sync rename --branch <b> --label "<l>"
        change the label players see, nothing is recalculated
  swgl-sync create --branch <code>          create a beta
  swgl-sync remove --branch <code>          close a beta (its files are kept)
  swgl-sync exclude --branch <code> [path...]
        drop base files from this beta; without a path, show the list
  swgl-sync restore --branch <code> <path...>
        undo an exclusion
  swgl-sync force-delete --branch <b> [path...]
        delete files from players' installs, even outside the launcher's own
        patterns; without a path, show the list
  swgl-sync cancel-delete --branch <b> <path...>
        undo a forced deletion

A branch is "$PUBLIC" or a beta code. Quote values with spaces: --label "Ep3 test 5".
Paths are relative to GameData ("SWGL/SWGL_Menu.pk3"). "*" stays within a
folder, "**" crosses folders; quote patterns so the shell leaves them alone.
EOF
    exit 1
}

# ------------------------------------------------------------------------------
# Options: --branch, --label, --notify [message], then positional paths
# ------------------------------------------------------------------------------

BRANCH=""
LABEL=""
NOTIFY=0
MESSAGE=""
HAS_LABEL=0
HAS_MESSAGE=0
PINGS=()
PATHS=()

parse_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --branch)
                [[ $# -ge 2 ]] || die "--branch needs a value"
                BRANCH=$2
                shift 2
                ;;
            --label)
                [[ $# -ge 2 && -n "$2" ]] || die "--label needs a value"
                LABEL=$2
                HAS_LABEL=1
                shift 2
                ;;
            --notify)
                NOTIFY=1
                shift
                # The message is optional: the next word, unless it is an option.
                if [[ $# -gt 0 && "$1" != --* ]]; then
                    MESSAGE=$1
                    HAS_MESSAGE=1
                    shift
                fi
                ;;
            --notify-ping)
                [[ $# -ge 2 && -n "$2" ]] || die "--notify-ping needs a role"
                PINGS+=("$2")
                shift 2
                ;;
            --*)
                die "unknown option: $1"
                ;;
            *)
                PATHS+=("$1")
                shift
                ;;
        esac
    done
}

# Refuses the options a command does not take: allow_only <option...>
allow_only() {
    local allowed=" $* "
    [[ -z "$BRANCH" || "$allowed" == *" branch "* ]] || die "--branch is not used by this command"
    [[ $HAS_LABEL -eq 0 || "$allowed" == *" label "* ]] || die "--label is not used by this command"
    [[ $NOTIFY -eq 0 || "$allowed" == *" notify "* ]] || die "--notify is not used by this command"
    [[ ${#PINGS[@]} -eq 0 || "$allowed" == *" notify "* ]] || die "--notify-ping is not used by this command"
    [[ ${#PATHS[@]} -eq 0 || "$allowed" == *" paths "* ]] || die "unexpected argument: ${PATHS[0]}"
}

need_branch() {
    [[ -n "$BRANCH" ]] || die "--branch is required"
}

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

check_code() {
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid code: $1"
    [[ "$1" != "$PUBLIC" ]] || die "\"$PUBLIC\" is reserved for the public channel"
}

reload_proftpd() {
    proftpd --configtest >/dev/null && systemctl reload proftpd
}

# Codes of the existing betas, from the beta-<code> folders of the repository.
list_betas() {
    local dir
    for dir in "$ROOT/$DIR_PREFIX"*/; do
        [[ -d "$dir" ]] || continue
        dir=${dir%/}
        echo "${dir##*/"$DIR_PREFIX"}"
    done
}

# List of base files excluded from a beta. Kept next to the .diff, outside the
# beta folder: never scanned into the manifest, never visible to testers.
remove_list() {
    echo "$ROOT/$DIR_PREFIX$1.remove"
}

# Files the launcher must delete from players' installs, even outside its own
# deletable patterns. Per branch: "public" or a beta code.
delete_list() {
    echo "$ROOT/forcedelete-$1.list"
}

# Patch notes of a branch: "public" or a beta code.
patchnotes_file() {
    echo "$ROOT/patchnotes-$1.md"
}

# The notes file always exists, empty until written: the FTP alias points to it.
ensure_patchnotes() {
    local file
    file=$(patchnotes_file "$1")
    [[ -e "$file" ]] || install -o "$OWNER" -g "$GROUP" -m 644 /dev/null "$file"
}

# Betas created before patch notes existed lack the alias: add it to their block.
ensure_patchnotes_alias() {
    local user="$USER_PREFIX$1"
    local line="  VRootAlias $(patchnotes_file "$1") patchnotes.md"

    [[ -f "$BETAS_CONF" ]] || return 0
    grep -Fxq -- "<IfUser $user>" "$BETAS_CONF" || return 0

    if awk -v u="<IfUser $user>" -v l="$line" '
            $0 == u { inside = 1 }
            inside && $0 == l { found = 1 }
            $0 == "</IfUser>" { inside = 0 }
            END { exit !found }
        ' "$BETAS_CONF"; then
        return 0
    fi

    awk -v u="<IfUser $user>" -v l="$line" '
        { print }
        $0 == u { print l }
    ' "$BETAS_CONF" > "$BETAS_CONF.tmp"
    mv "$BETAS_CONF.tmp" "$BETAS_CONF"

    echo "  patch notes alias added for $user"
    reload_proftpd
}

require_beta() {
    check_code "$1"
    [[ -d "$ROOT/$DIR_PREFIX$1" ]] || die "unknown beta: $1 ($ROOT/$DIR_PREFIX$1 missing)"
}

# A branch: "public" or an existing beta.
require_branch() {
    [[ "$1" == "$PUBLIC" ]] || require_beta "$1"
}

# Path relative to GameData, "/" separators, no leading "/" and no "..".
normalize_path() {
    # Quotes are never part of a path: typed at the swgl-sync> prompt, they would
    # otherwise end up in the list and the pattern would match nothing.
    local path=${1//[\"\']/}
    path=${path//\\//}
    path=${path#/}

    [[ -n "$path" ]] || die "empty path"
    [[ "/$path/" != */../* ]] || die "path rejected: $1"

    echo "$path"
}

# Manifest of a branch: "public" or a beta code.
manifest_file() {
    if [[ "$1" == "$PUBLIC" ]]; then
        echo "$ROOT/manifest-public.json"
    else
        echo "$ROOT/$DIR_PREFIX$1/manifest.json"
    fi
}

# ------------------------------------------------------------------------------
# update / rename
# ------------------------------------------------------------------------------

# Where the manifest tool writes what changed per branch, when --notify is set.
CHANGES_DIR=""

# Manifest tool options shared by every branch: label and change report.
common_args() {
    local branch=$1
    COMMON=()

    # Without a label, the tool keeps the one already published.
    [[ $HAS_LABEL -eq 1 ]] && COMMON+=(--version "$LABEL")
    [[ -n "$CHANGES_DIR" ]] && COMMON+=(--changes "$CHANGES_DIR/$branch.json")
    return 0
}

update_public() {
    ensure_patchnotes "$PUBLIC"
    common_args "$PUBLIC"

    # Files players must delete, even outside the launcher's own patterns.
    local deletions=()
    local list
    list=$(delete_list "$PUBLIC")
    [[ -s "$list" ]] && deletions=(--delete-list "$list")

    echo "== $PUBLIC"
    "$MANIFEST_TOOL" --source "$ROOT/base" --source-prefix /base \
                     "${deletions[@]}" \
                     "${COMMON[@]}" \
                     --channel "$PUBLIC" \
                     --output "$(manifest_file "$PUBLIC")"
    chown "$OWNER:$GROUP" "$(manifest_file "$PUBLIC")"
}

update_beta() {
    local code=$1
    local home="$ROOT/$DIR_PREFIX$code"

    [[ -d "$home" ]] || die "unknown beta: $code ($home missing)"
    ensure_patchnotes "$code"
    ensure_patchnotes_alias "$code"
    common_args "$code"

    # Base files come from the public manifest, already hashed: only the beta's
    # own files are read. Without a public manifest yet, base is scanned.
    local base=(--base "$ROOT/base" --base-prefix /base)
    [[ -f "$(manifest_file "$PUBLIC")" ]] && base=(--base-manifest "$(manifest_file "$PUBLIC")")

    # The beta's own files win over base files at the same path, and the ones
    # in the exclusion list are dropped from base.
    local removals=()
    local list
    list=$(remove_list "$code")
    [[ -s "$list" ]] && removals=(--remove-list "$list")

    # Files players must delete, even outside the launcher's own patterns.
    local deletions=()
    list=$(delete_list "$code")
    [[ -s "$list" ]] && deletions=(--delete-list "$list")

    echo "== beta $code"
    "$MANIFEST_TOOL" --source "$home" --source-prefix "/$DIR_PREFIX$code" \
                     "${base[@]}" \
                     "${removals[@]}" \
                     "${deletions[@]}" \
                     "${COMMON[@]}" \
                     --channel "$DIR_PREFIX$code" \
                     --output "$(manifest_file "$code")"
    chown "$OWNER:$GROUP" "$(manifest_file "$code")"
}

cmd_update() {
    allow_only branch label notify

    # One label for every branch is never what was meant.
    [[ $HAS_LABEL -eq 0 || -n "$BRANCH" ]] || die "--label needs --branch"
    [[ -z "$BRANCH" ]] || require_branch "$BRANCH"

    [[ ${#PINGS[@]} -eq 0 || $NOTIFY -eq 1 ]] || die "--notify-ping needs --notify"

    if [[ $NOTIFY -eq 1 ]]; then
        # Checked first: better to refuse now than after a long update.
        grep -Eq '^[[:space:]]*webhook[[:space:]]*=[[:space:]]*[^[:space:]]' "$CONFIG" 2>/dev/null \
            || die "--notify needs webhook=... in $CONFIG"

        # A role is an identifier, or a name declared in the configuration.
        local ping name
        for ping in "${PINGS[@]}"; do
            name=${ping#@}
            [[ "$name" =~ ^[0-9]+$ ]] && continue
            [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid role: $ping"
            grep -Eiq "^[[:space:]]*role\.$name[[:space:]]*=[[:space:]]*[0-9]+[[:space:]]*\$" "$CONFIG" \
                || die "unknown role: $ping (declare role.$name=<id> in $CONFIG, or give the role id)"
        done

        CHANGES_DIR=$(mktemp -d)
        trap 'rm -rf "$CHANGES_DIR"' EXIT
    fi

    if [[ -z "$BRANCH" ]]; then
        update_public

        local code
        while read -r code; do
            update_beta "$code"
        done < <(list_betas)
    elif [[ "$BRANCH" == "$PUBLIC" ]]; then
        update_public

        # Every beta manifest carries the public files with their checksums: if
        # base changed, they are out of date.
        if [[ -n "$(list_betas)" ]]; then
            echo "note: betas take their base files from the public manifest; if base changed, 'swgl-sync update' refreshes them too." >&2
        fi
    else
        update_beta "$BRANCH"
    fi

    if [[ $NOTIFY -eq 1 ]]; then
        local message=()
        [[ $HAS_MESSAGE -eq 1 ]] && message=(--message "$MESSAGE")
        local ping
        for ping in "${PINGS[@]}"; do
            message+=(--ping "$ping")
        done

        echo "== Discord"
        "$MANIFEST_TOOL" --notify "$CHANGES_DIR" "${message[@]}" --config "$CONFIG"
    fi
}

# Changes the label players see, without regenerating the manifest.
cmd_rename() {
    allow_only branch label
    need_branch
    [[ $HAS_LABEL -eq 1 ]] || die "--label is required"
    require_branch "$BRANCH"

    local manifest
    manifest=$(manifest_file "$BRANCH")
    [[ -f "$manifest" ]] || die "no manifest yet for $BRANCH: run 'swgl-sync update --branch $BRANCH' first"

    "$MANIFEST_TOOL" --relabel --output "$manifest" --version "$LABEL"
    chown "$OWNER:$GROUP" "$manifest"
}

# ------------------------------------------------------------------------------
# create / remove
# ------------------------------------------------------------------------------

cmd_create() {
    allow_only branch
    need_branch

    local code=$BRANCH
    check_code "$code"

    local user="$USER_PREFIX$code"
    local jail="$JAILS/$user"
    local home="$ROOT/$DIR_PREFIX$code"
    local diff="$ROOT/$DIR_PREFIX$code.diff"

    if id "$user" &>/dev/null; then
        die "account $user already exists"
    fi

    # Beta files belong to the publishing account.
    install -d -o "$OWNER" -g "$GROUP" -m 755 "$home"
    [[ -f "$diff" ]] || install -o "$OWNER" -g "$GROUP" -m 644 /dev/null "$diff"
    ensure_patchnotes "$code"

    # The jail is empty and owned by root: nothing can be written to it.
    install -d -o root -g root -m 755 "$jail"

    useradd --home-dir "$jail" --no-create-home --shell /usr/sbin/nologin \
            --gid "$GROUP" "$user"

    # Password = code: whoever knows the code has access to the beta anyway.
    echo "$user:$code" | chpasswd

    touch "$BETAS_CONF"
    cat >> "$BETAS_CONF" <<EOF

<IfUser $user>
  DefaultRoot $jail
  VRootAlias $ROOT/base base
  VRootAlias $home $DIR_PREFIX$code
  VRootAlias $diff $DIR_PREFIX$code.diff
  VRootAlias $home/manifest.json manifest.json
  VRootAlias $(patchnotes_file "$code") patchnotes.md
</IfUser>
EOF

    reload_proftpd

    echo "beta $code created"
    echo "  account  : $user"
    echo "  password : $code"
    echo "  files    : $home"
    echo "  notes    : $(patchnotes_file "$code") (Markdown, empty = none)"
    echo "  next     : upload the files, then 'swgl-sync update --branch $code'"
}

cmd_remove() {
    allow_only branch
    need_branch

    local code=$BRANCH
    check_code "$code"

    local user="$USER_PREFIX$code"
    local jail="$JAILS/$user"

    if id "$user" &>/dev/null; then
        userdel "$user"
    else
        echo "  (account $user already gone)"
    fi

    rmdir "$jail" 2>/dev/null || true

    # Drop the <IfUser swgl-code>...</IfUser> block.
    if [[ -f "$BETAS_CONF" ]]; then
        awk -v u="$user" '
            $0 == "<IfUser " u ">" { skip = 1 }
            skip == 0 { print }
            $0 == "</IfUser>" && skip == 1 { skip = 0 }
        ' "$BETAS_CONF" > "$BETAS_CONF.tmp"
        mv "$BETAS_CONF.tmp" "$BETAS_CONF"
    fi

    reload_proftpd

    echo "beta $code closed: account and access removed"
    echo "  files kept: $ROOT/$DIR_PREFIX$code, $ROOT/$DIR_PREFIX$code.diff and $(patchnotes_file "$code")"
}

# ------------------------------------------------------------------------------
# Path lists: exclude / restore, force-delete / cancel-delete
# ------------------------------------------------------------------------------

# Shows a list: list_show <file> <heading> <message when empty>
list_show() {
    if [[ -s "$1" ]]; then
        echo "$2"
        sed 's/^/  /' "$1"
    else
        echo "$3"
    fi
}

# Adds paths to a list: list_add <file> <path...>
list_add() {
    local list=$1
    shift

    [[ -f "$list" ]] || install -o "$OWNER" -g "$GROUP" -m 644 /dev/null "$list"

    local path
    for path in "$@"; do
        path=$(normalize_path "$path")

        if grep -Fxq -- "$path" "$list"; then
            echo "  already listed: $path"
            continue
        fi

        echo "$path" >> "$list"
        echo "  added: $path"
    done
}

# Removes paths from a list: list_drop <file> <path...>
list_drop() {
    local list=$1
    shift

    local path
    for path in "$@"; do
        path=$(normalize_path "$path")

        if grep -Fxq -- "$path" "$list"; then
            # grep -v fails when no line is left: not an error here.
            grep -Fxv -- "$path" "$list" > "$list.tmp" || true
            cat "$list.tmp" > "$list"
            rm -f "$list.tmp"
            echo "  removed: $path"
        else
            echo "  not in the list: $path"
        fi
    done
}

cmd_exclude() {
    allow_only branch paths
    need_branch
    require_beta "$BRANCH"

    local list
    list=$(remove_list "$BRANCH")

    if [[ ${#PATHS[@]} -eq 0 ]]; then
        list_show "$list" "base files excluded from beta $BRANCH:" "no base file excluded from beta $BRANCH"
        return
    fi

    # An exact path missing from base is almost always a typo.
    local path
    for path in "${PATHS[@]}"; do
        path=$(normalize_path "$path")
        if [[ "$path" != *[*?]* && ! -e "$ROOT/base/$path" ]]; then
            echo "  warning: $path does not exist in base" >&2
        fi
    done

    list_add "$list" "${PATHS[@]}"
    echo "next: swgl-sync update --branch $BRANCH"
}

cmd_restore() {
    allow_only branch paths
    need_branch
    require_beta "$BRANCH"
    [[ ${#PATHS[@]} -gt 0 ]] || die "no path given"

    local list
    list=$(remove_list "$BRANCH")
    [[ -s "$list" ]] || die "no base file excluded from beta $BRANCH"

    list_drop "$list" "${PATHS[@]}"
    echo "next: swgl-sync update --branch $BRANCH"
}

cmd_force_delete() {
    allow_only branch paths
    need_branch
    require_branch "$BRANCH"

    local list
    list=$(delete_list "$BRANCH")

    if [[ ${#PATHS[@]} -eq 0 ]]; then
        list_show "$list" "files deleted from players' installs on $BRANCH:" "no forced deletion on $BRANCH"
        return
    fi

    list_add "$list" "${PATHS[@]}"
    echo "next: swgl-sync update --branch $BRANCH"
}

cmd_cancel_delete() {
    allow_only branch paths
    need_branch
    require_branch "$BRANCH"
    [[ ${#PATHS[@]} -gt 0 ]] || die "no path given"

    local list
    list=$(delete_list "$BRANCH")
    [[ -s "$list" ]] || die "no forced deletion on $BRANCH"

    list_drop "$list" "${PATHS[@]}"
    echo "next: swgl-sync update --branch $BRANCH"
}

# ------------------------------------------------------------------------------

[[ $EUID -eq 0 ]] || die "must be run as root (sudo)"

COMMAND=${1:-}
[[ $# -gt 0 ]] && shift
parse_options "$@"

case "$COMMAND" in
    update)        cmd_update ;;
    rename)        cmd_rename ;;
    create)        cmd_create ;;
    remove)        cmd_remove ;;
    exclude)       cmd_exclude ;;
    restore)       cmd_restore ;;
    force-delete)  cmd_force_delete ;;
    cancel-delete) cmd_cancel_delete ;;
    *)             usage ;;
esac
