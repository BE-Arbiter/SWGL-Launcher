#!/usr/bin/env bash
# ==============================================================================
# swgl-sync — manages the branches of the SWGL FTP repository: public and betas.
#
#   swgl-sync update                    regenerate public, then every beta
#   swgl-sync update <branch> [ver]     regenerate one branch: "public" or a code
#   swgl-sync create <code>             create a beta
#   swgl-sync remove <code>             close a beta (its files are kept)
#   swgl-sync exclude <code> [path]     drop base files from this beta
#   swgl-sync restore <code> <path>     undo an exclusion
#
# Beta <code> gets the account "swgl-<code>", password "<code>", which sees
# /base, /beta-<code>, /beta-<code>.diff and its own /manifest.json.
# ==============================================================================
set -euo pipefail

ROOT=/srv/swgl
JAILS=/srv/swgl-jails
GROUP=swgl
OWNER=swgl-dev
BETAS_CONF=/etc/proftpd/conf.d/swgl-betas.conf
MANIFEST_TOOL=${MANIFEST_TOOL:-SWGLManifest}

# Account prefix: must match the launcher's ftp.beta.user.prefix.
USER_PREFIX=swgl-
# Prefix of the beta folders and .diff files on disk.
DIR_PREFIX=beta-
PUBLIC=public

die() {
    echo "swgl-sync: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<EOF
usage:
  swgl-sync update                    public, then every beta
  swgl-sync update <branch> [ver]     one branch: "$PUBLIC" or a beta code
  swgl-sync create <code>             create a beta
  swgl-sync remove <code>             close a beta (its files are kept)
  swgl-sync exclude <code> [path]     drop base files from this beta;
                                      without a path, show the list
  swgl-sync restore <code> <path>     undo an exclusion

Paths are relative to GameData ("SWGL/SWGL_Menu.pk3"). "*" stays within a
folder, "**" crosses folders. In a shell, quote patterns; at the swgl-sync>
prompt, type them as is.
EOF
    exit 1
}

check_code() {
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid code: $1"
    [[ "$1" != "$PUBLIC" ]] || die "\"$PUBLIC\" is reserved for the public channel"
}

reload_proftpd() {
    proftpd --configtest >/dev/null && systemctl reload proftpd
}

# Codes of the existing betas, from the beta-<code> folders of the repository.
list_betas() {
    local dir
    for dir in "$ROOT/$DIR_PREFIX"*/; do
        [[ -d "$dir" ]] || continue
        dir=${dir%/}
        echo "${dir##*/"$DIR_PREFIX"}"
    done
}

default_version() {
    date +%Y.%m.%d.%H%M
}

# List of base files excluded from a beta. Kept next to the .diff, outside the
# beta folder: never scanned into the manifest, never visible to testers.
remove_list() {
    echo "$ROOT/$DIR_PREFIX$1.remove"
}

require_beta() {
    check_code "$1"
    [[ -d "$ROOT/$DIR_PREFIX$1" ]] || die "unknown beta: $1 ($ROOT/$DIR_PREFIX$1 missing)"
}

# Path relative to GameData, "/" separators, no leading "/" and no "..".
normalize_path() {
    local path=${1//\\//}
    path=${path#/}

    [[ -n "$path" ]] || die "empty path"
    [[ "/$path/" != */../* ]] || die "path rejected: $1"

    echo "$path"
}

# ------------------------------------------------------------------------------
# update
# ------------------------------------------------------------------------------

update_public() {
    local version=${1:-$(default_version)}

    echo "== $PUBLIC ($version)"
    "$MANIFEST_TOOL" --source "$ROOT/base" --source-prefix /base \
                     --channel "$PUBLIC" --version "$version" \
                     --output "$ROOT/manifest-public.json"
    chown "$OWNER:$GROUP" "$ROOT/manifest-public.json"
}

update_beta() {
    local code=$1
    local version=${2:-$(default_version)}
    local home="$ROOT/$DIR_PREFIX$code"

    [[ -d "$home" ]] || die "unknown beta: $code ($home missing)"

    # The beta's own files win over base files at the same path, and the ones
    # in the exclusion list are dropped from base.
    local removals=()
    local list
    list=$(remove_list "$code")
    [[ -s "$list" ]] && removals=(--remove-list "$list")

    echo "== beta $code ($version)"
    "$MANIFEST_TOOL" --source "$home" --source-prefix "/$DIR_PREFIX$code" \
                     --base "$ROOT/base" --base-prefix /base \
                     "${removals[@]}" \
                     --channel "$DIR_PREFIX$code" --version "$version" \
                     --output "$home/manifest.json"
    chown "$OWNER:$GROUP" "$home/manifest.json"
}

cmd_update() {
    if [[ $# -eq 0 ]]; then
        update_public

        local code
        while read -r code; do
            update_beta "$code"
        done < <(list_betas)

        return
    fi

    local branch=$1
    shift
    [[ $# -le 1 ]] || usage

    if [[ "$branch" == "$PUBLIC" ]]; then
        update_public "$@"

        # Every beta manifest carries the base files with their checksums: if
        # base changed, they are out of date.
        if [[ -n "$(list_betas)" ]]; then
            echo "note: betas include base; if base changed, 'swgl-sync update' regenerates them too." >&2
        fi
    else
        check_code "$branch"
        update_beta "$branch" "$@"
    fi
}

# ------------------------------------------------------------------------------
# create
# ------------------------------------------------------------------------------

cmd_create() {
    [[ $# -eq 1 ]] || usage

    local code=$1
    check_code "$code"

    local user="$USER_PREFIX$code"
    local jail="$JAILS/$user"
    local home="$ROOT/$DIR_PREFIX$code"
    local diff="$ROOT/$DIR_PREFIX$code.diff"

    if id "$user" &>/dev/null; then
        die "account $user already exists"
    fi

    # Beta files belong to the publishing account.
    install -d -o "$OWNER" -g "$GROUP" -m 755 "$home"
    [[ -f "$diff" ]] || install -o "$OWNER" -g "$GROUP" -m 644 /dev/null "$diff"

    # The jail is empty and owned by root: nothing can be written to it.
    install -d -o root -g root -m 755 "$jail"

    useradd --home-dir "$jail" --no-create-home --shell /usr/sbin/nologin \
            --gid "$GROUP" "$user"

    # Password = code: whoever knows the code has access to the beta anyway.
    echo "$user:$code" | chpasswd

    touch "$BETAS_CONF"
    cat >> "$BETAS_CONF" <<EOF

<IfUser $user>
  DefaultRoot $jail
  VRootAlias $ROOT/base base
  VRootAlias $home $DIR_PREFIX$code
  VRootAlias $diff $DIR_PREFIX$code.diff
  VRootAlias $home/manifest.json manifest.json
</IfUser>
EOF

    reload_proftpd

    echo "beta $code created"
    echo "  account  : $user"
    echo "  password : $code"
    echo "  files    : $home"
    echo "  next     : upload the files, then 'swgl-sync update $code'"
}

# ------------------------------------------------------------------------------
# remove
# ------------------------------------------------------------------------------

cmd_remove() {
    [[ $# -eq 1 ]] || usage

    local code=$1
    check_code "$code"

    local user="$USER_PREFIX$code"
    local jail="$JAILS/$user"

    if id "$user" &>/dev/null; then
        userdel "$user"
    else
        echo "  (account $user already gone)"
    fi

    rmdir "$jail" 2>/dev/null || true

    # Drop the <IfUser swgl-code>...</IfUser> block.
    if [[ -f "$BETAS_CONF" ]]; then
        awk -v u="$user" '
            $0 == "<IfUser " u ">" { skip = 1 }
            skip == 0 { print }
            $0 == "</IfUser>" && skip == 1 { skip = 0 }
        ' "$BETAS_CONF" > "$BETAS_CONF.tmp"
        mv "$BETAS_CONF.tmp" "$BETAS_CONF"
    fi

    reload_proftpd

    echo "beta $code closed: account and access removed"
    echo "  files kept: $ROOT/$DIR_PREFIX$code and $ROOT/$DIR_PREFIX$code.diff"
}

# ------------------------------------------------------------------------------
# exclude / restore
# ------------------------------------------------------------------------------

cmd_exclude() {
    [[ $# -ge 1 ]] || usage

    local code=$1
    shift
    require_beta "$code"

    local list
    list=$(remove_list "$code")

    # Without a path: show the list.
    if [[ $# -eq 0 ]]; then
        if [[ -s "$list" ]]; then
            echo "base files excluded from beta $code:"
            sed 's/^/  /' "$list"
        else
            echo "no base file excluded from beta $code"
        fi
        return
    fi

    if [[ ! -f "$list" ]]; then
        install -o "$OWNER" -g "$GROUP" -m 644 /dev/null "$list"
    fi

    local path
    for path in "$@"; do
        path=$(normalize_path "$path")

        if grep -Fxq -- "$path" "$list"; then
            echo "  already excluded: $path"
            continue
        fi

        # An exact path missing from base is almost always a typo.
        if [[ "$path" != *[*?]* && ! -e "$ROOT/base/$path" ]]; then
            echo "  warning: $path does not exist in base" >&2
        fi

        echo "$path" >> "$list"
        echo "  excluded: $path"
    done

    echo "next: swgl-sync update $code"
}

cmd_restore() {
    [[ $# -ge 2 ]] || usage

    local code=$1
    shift
    require_beta "$code"

    local list
    list=$(remove_list "$code")
    [[ -s "$list" ]] || die "no base file excluded from beta $code"

    local path
    for path in "$@"; do
        path=$(normalize_path "$path")

        if grep -Fxq -- "$path" "$list"; then
            # grep -v fails when no line is left: not an error here.
            grep -Fxv -- "$path" "$list" > "$list.tmp" || true
            cat "$list.tmp" > "$list"
            rm -f "$list.tmp"
            echo "  restored: $path"
        else
            echo "  not in the list: $path"
        fi
    done

    echo "next: swgl-sync update $code"
}

# ------------------------------------------------------------------------------

[[ $EUID -eq 0 ]] || die "must be run as root (sudo)"

case "${1:-}" in
    update)  shift; cmd_update "$@" ;;
    create)  shift; cmd_create "$@" ;;
    remove)  shift; cmd_remove "$@" ;;
    exclude) shift; cmd_exclude "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    *)       usage ;;
esac
