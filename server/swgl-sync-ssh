#!/usr/bin/python3 -I
# ==============================================================================
# swgl-sync-ssh — the only thing swgl-dev can run over SSH (sshd ForceCommand).
#
#   ssh swgl-dev@server update          runs "swgl-sync update" and exits
#   ssh swgl-dev@server                 swgl-sync> prompt
#
# The prompt has line editing, history (arrow keys, Ctrl+R) and Tab completion
# of commands, branches and paths. A line is never interpreted by a shell: it is
# split into words, quotes grouping words ("Ep3 test 4"), with no escapes, no
# substitution and no pattern expansion, then handed to swgl-sync through sudo.
#
# Python rather than bash on purpose: bash's line editing (read -e) has key
# bindings that run commands (edit-and-execute-command, shell-expand-line...).
# GNU readline as used here only edits text.
# ==============================================================================
import os
import shlex
import signal
import subprocess
import sys

SWGL_SYNC = "/usr/local/sbin/swgl-sync"
ROOT = "/srv/swgl"
PUBLIC = "public"
DIR_PREFIX = "beta-"

# Command -> its options, and what --branch takes: any branch, a beta, or a new code.
COMMANDS = {
    "update": (["--branch", "--label", "--notify"], "branch"),
    "rename": (["--branch", "--label"], "branch"),
    "create": (["--branch"], None),
    "remove": (["--branch"], "beta"),
    "exclude": (["--branch"], "beta"),
    "restore": (["--branch"], "beta"),
    "force-delete": (["--branch"], "branch"),
    "cancel-delete": (["--branch"], "branch"),
    "help": ([], None),
    "exit": ([], None),
}

# Commands whose remaining words are paths.
PATH_COMMANDS = ("exclude", "restore", "force-delete", "cancel-delete")


def split_words(line):
    """Words of a line: quotes group, nothing else is special."""
    lexer = shlex.shlex(line, posix=True)
    lexer.whitespace_split = True
    lexer.escape = ""
    lexer.commenters = ""

    try:
        words = list(lexer)
    except ValueError:
        # Unclosed quote: take the rest of the line as typed.
        words = line.replace('"', " ").replace("'", " ").split()

    if words and words[0] == "swgl-sync":
        words = words[1:]

    return words


def run(words):
    try:
        return subprocess.call(["sudo", "-n", SWGL_SYNC, *words])
    except KeyboardInterrupt:
        return 130


# ------------------------------------------------------------------------------
# Completion
# ------------------------------------------------------------------------------

def betas():
    try:
        return sorted(
            name[len(DIR_PREFIX):]
            for name in os.listdir(ROOT)
            if name.startswith(DIR_PREFIX) and os.path.isdir(os.path.join(ROOT, name))
        )
    except OSError:
        return []


def list_lines(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return [line.strip() for line in handle if line.strip()]
    except OSError:
        return []


def paths_under(folder, prefix):
    """Relative paths under a folder completing a prefix, folder by folder."""
    head, _, tail = prefix.rpartition("/")
    directory = os.path.join(folder, head) if head else folder

    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return []

    matches = []
    for name in names:
        if not name.startswith(tail):
            continue

        relative = f"{head}/{name}" if head else name
        if os.path.isdir(os.path.join(directory, name)):
            relative += "/"
        matches.append(relative)

    return matches


def path_candidates(command, branch, current):
    """Paths for the list commands, once the branch is known."""
    if command == "exclude":
        return paths_under(os.path.join(ROOT, "base"), current)

    if command == "force-delete":
        options = paths_under(os.path.join(ROOT, "base"), current)
        if branch != PUBLIC:
            options += paths_under(os.path.join(ROOT, f"{DIR_PREFIX}{branch}"), current)
        return sorted(set(options))

    if command == "restore":
        options = list_lines(os.path.join(ROOT, f"{DIR_PREFIX}{branch}.remove"))
    else:
        options = list_lines(os.path.join(ROOT, f"forcedelete-{branch}.list"))

    return [option for option in options if option.startswith(current)]


def candidates(words, current):
    """Possible values for the word being typed, given the words before it."""
    if not words:
        return [command for command in COMMANDS if command.startswith(current)]

    command = words[0]
    options, branch_kind = COMMANDS.get(command, ([], None))
    previous = words[-1] if len(words) > 1 else None

    # The value of --branch.
    if previous == "--branch":
        if branch_kind == "branch":
            values = [PUBLIC, *betas()]
        elif branch_kind == "beta":
            values = betas()
        else:
            values = []
        return [value for value in values if value.startswith(current)]

    # Free text: a label, or the message of --notify (which may also be skipped).
    if previous == "--label" or (previous == "--notify" and not current.startswith("-")):
        return []

    unused = [option for option in options if option not in words]

    if current.startswith("-") or command not in PATH_COMMANDS:
        return [option for option in unused if option.startswith(current)]

    # A list command: paths once the branch is given, otherwise --branch first.
    if "--branch" in words:
        index = words.index("--branch")
        if index + 1 < len(words):
            return path_candidates(command, words[index + 1], current)

    return [option for option in unused if option.startswith(current)]


def setup_readline():
    # Never read an inputrc that swgl-dev could have written.
    os.environ["INPUTRC"] = "/dev/null"

    import readline

    state = {"matches": []}

    def complete(text, index):
        if index == 0:
            buffer = readline.get_line_buffer()[: readline.get_begidx()]
            state["matches"] = candidates(split_words(buffer), text)
        matches = state["matches"]
        if index >= len(matches):
            return None
        match = matches[index]
        # A folder is completed further, anything else ends the word.
        return match if match.endswith("/") else match + " "

    readline.set_completer(complete)
    readline.set_completer_delims(" \t")
    readline.parse_and_bind("tab: complete")
    readline.parse_and_bind("set completion-ignore-case off")
    readline.parse_and_bind("set show-all-if-ambiguous on")


# ------------------------------------------------------------------------------

def main():
    command = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip()

    # ssh swgl-dev@server update: run and exit.
    if command:
        return run(split_words(command))

    # Ctrl+C at the prompt clears the line; during a command it stops the command.
    signal.signal(signal.SIGINT, signal.default_int_handler)

    if sys.stdin.isatty():
        setup_readline()

    print("swgl-sync - Tab completes, arrows browse history; 'help' for usage, 'exit' to quit")

    while True:
        try:
            line = input("swgl-sync> ")
        except KeyboardInterrupt:
            print()
            continue
        except EOFError:
            print()
            return 0

        words = split_words(line)

        if not words:
            continue
        if words[0] in ("exit", "quit"):
            return 0
        if words[0] == "help":
            words = []

        run(words)


if __name__ == "__main__":
    sys.exit(main())
