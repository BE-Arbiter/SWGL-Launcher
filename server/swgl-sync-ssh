#!/bin/bash
# ==============================================================================
# swgl-sync-ssh — the only thing swgl-dev can run over SSH (sshd ForceCommand).
#
#   ssh swgl-dev@server update          runs "swgl-sync update" and exits
#   ssh swgl-dev@server                 swgl-sync> prompt
#
# A line is never interpreted by a shell: it is only split into words, quotes
# grouping words ("Ep3 test 4"), with no substitution and no pattern expansion,
# then handed to swgl-sync through sudo.
# No line editing on purpose: bash's (read -e) has bindings that run commands.
# ==============================================================================

# Splits a line into words. '...' and "..." group words and are removed; nothing
# else is special: no escapes, no variables, no substitution, no patterns.
split_words() {
    local line=$1 word="" quote="" c i started=0
    words=()

    for (( i = 0; i < ${#line}; i++ )); do
        c=${line:i:1}

        if [[ -n "$quote" ]]; then
            if [[ "$c" == "$quote" ]]; then quote=""; else word+=$c; fi
        elif [[ "$c" == "'" || "$c" == '"' ]]; then
            quote=$c
            started=1
        elif [[ "$c" == [[:space:]] ]]; then
            (( started )) && words+=("$word")
            word=""
            started=0
        else
            word+=$c
            started=1
        fi
    done

    (( started )) && words+=("$word")
    return 0
}

run() {
    local words
    split_words "$1"
    [[ "${words[0]:-}" == swgl-sync ]] && words=("${words[@]:1}")
    sudo -n /usr/local/sbin/swgl-sync "${words[@]}"
}

if [[ -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
    run "$SSH_ORIGINAL_COMMAND"
    exit
fi

# Ctrl+C interrupts the running command without closing the session; Ctrl+D or
# "exit" close it.
trap 'echo' INT
echo "swgl-sync - 'help' for usage, 'exit' to quit"

while true; do
    if ! read -rp 'swgl-sync> ' line; then
        (( $? > 128 )) && continue
        echo
        break
    fi

    case "$line" in
        "")        ;;
        exit|quit) break ;;
        help)      run "" ;;
        *)         run "$line" ;;
    esac
done
